POSTGRES_USER=fleetpulse
POSTGRES_PASSWORD=fleetpulse
POSTGRES_DB=fleetpulse
DATABASE_URL=postgres://fleetpulse:fleetpulse@127.0.0.1:5435/fleetpulse?sslmode=disable
SIM_SEED=1
CALENDAR_RATE=4h/s
# HMAC secret mixed with the visitor IP when hashing audit entries
AUDIT_HASH_SECRET=
# When true, hash the first X-Forwarded-For hop instead of RemoteAddr
TRUST_FORWARDED_FOR=false
